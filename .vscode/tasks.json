{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: build",
            "type": "cmake",
            "command": "build"
        },
        {
            "label": "Run packaged",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-File", "install.ps1", "${command:cmake.buildType}"],
            "dependsOn": ["CMake: build"],
            "problemMatcher": []
        }
    ]
}
